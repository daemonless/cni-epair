#!/bin/sh
#
# epair - CNI plugin for FreeBSD epair/bridge networking
#
# This plugin creates epair interfaces and attaches them to bridges,
# providing macvlan-like functionality for FreeBSD jails/containers.
#
# Config options (in CNI config JSON):
#   bridge: name of bridge to attach to (required)
#   mtu: MTU for both ends of the epair (optional, 576-65535; default: the bridge's)
#   vlan: untagged VLAN ID on a vlanfilter bridge (optional, 1-4094)
#   taggedVlans: VLANs allowed tagged, ifconfig's list syntax (optional, "3,4", "10-20")
#   leaseDns: true to return the DHCP lease's DNS server (optional; default: not returned)
#
# IPAM must provide:
#   ips[].address: IP address with prefix (e.g., "192.168.86.8/24")
#   ips[].gateway: gateway address
#
# Capabilities:
#   mac: MAC address assignment
#   ips: static IP assignment

# Paths are overridable so the plugin can be exercised outside a real host;
# the defaults are what production uses and are unchanged.
LOG_FILE="${CNI_EPAIR_LOG:-/var/log/cni-freebsd-epair.log}"

# Redirect all stderr to log file to avoid polluting podman's parsing
exec 2>>"$LOG_FILE"

log() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') [$$] $*" >> "$LOG_FILE" 2>/dev/null || :
}

die() {
    log "ERROR: $1"
    # Escaped, or a message quoting an example ("3,4") is not JSON and the
    # runtime reports a parse error instead of the reason.
    local msg
    msg=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
    printf '{\n  "cniVersion": "1.0.0",\n  "code": 100,\n  "msg": "%s"\n}\n' "$msg"
    exit 1
}

# ipam_plugin <type> -- the IPAM binary, from CNI_PATH as the runtime sets it,
# then the FreeBSD default.
ipam_plugin() {
    local dir search="${CNI_PATH:+$CNI_PATH:}/usr/local/libexec/cni"
    local IFS=:
    for dir in $search; do
        if [ -n "$dir" ] && [ -x "$dir/$1" ]; then
            echo "$dir/$1"
            return 0
        fi
    done
    return 1
}

# Read entire stdin
read_config() {
    cat
}

# An address is v6 if it contains a colon. Everything below branches on this
# rather than on configuration: a conflist can carry both families at once and
# the plugin should not need telling which is which.
is_v6() {
    case "$1" in *:*) return 0 ;; *) return 1 ;; esac
}

# Extract JSON value using simple parsing (no jq dependency)
json_get() {
    echo "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" | head -1
}

# Like json_get, but also takes a bare number ("vlan": 2 as well as "vlan": "2")
json_get_scalar() {
    local v=$(json_get "$1" "$2")
    [ -n "$v" ] || v=$(echo "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p" | head -1)
    echo "$v"
}

# True if the config has the key at all, whatever its value
json_has() {
    echo "$1" | grep -q "\"$2\"[[:space:]]*:"
}

# Extract nested value like prevResult.interfaces[0].name
json_get_nested() {
    echo "$1" | grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 | sed 's/.*"\([^"]*\)"$/\1/'
}

# Get jail ID (numeric JID) from container ID
get_jail_id() {
    local container_id="$1"
    # On FreeBSD with ocijail, CNI_NETNS is the container ID
    # We need to find the numeric jail ID
    # Try short match first (first 12 chars), then full
    local short_id=$(echo "$container_id" | cut -c1-12)
    local jid=$(jls name jid | grep -E "^${short_id}|^${container_id}" | awk '{print $2}' | head -1)
    if [ -z "$jid" ]; then
        # Try matching anywhere in the name
        jid=$(jls -N name jid 2>/dev/null | grep "$short_id" | awk '{print $NF}' | head -1)
    fi
    if [ -z "$jid" ]; then
        # Last resort - list all and grep
        jid=$(jls | grep "$short_id" | awk '{print $1}' | head -1)
    fi
    echo "$jid"
}

# Track epair and installed default routes for cleanup and multi-network runs
save_epair() {
    local container_id="$1"
    local epair_a="$2"
    local state_dir="${CNI_EPAIR_STATE:-/var/run/cni/freebsd-epair}"
    mkdir -p "$state_dir"
    echo "$epair_a" > "$state_dir/$container_id"
}

get_epair() {
    local container_id="$1"
    local state_dir="${CNI_EPAIR_STATE:-/var/run/cni/freebsd-epair}"
    cat "$state_dir/$container_id" 2>/dev/null
}

save_gateway() {
    local container_id="$1" jail_id="$2" fam="$3" gw="$4" net_name="${5:-}"
    local state_dir="${CNI_EPAIR_STATE:-/var/run/cni/freebsd-epair}"
    local file="$state_dir/$container_id.gw" tmp=""
    mkdir -p "$state_dir"
    if [ -f "$file" ]; then
        tmp=$(awk -v j="$jail_id" -v f="$fam" '!($1 == j && $2 == f)' "$file" 2>/dev/null || true)
    fi
    {
        [ -n "$tmp" ] && printf '%s\n' "$tmp"
        printf '%s %s %s %s\n' "$jail_id" "$fam" "$gw" "$net_name"
    } > "$file"
}

has_own_gateway() {
    local container_id="$1" jail_id="$2" fam="$3" gw="$4"
    local state_dir="${CNI_EPAIR_STATE:-/var/run/cni/freebsd-epair}"
    [ -f "$state_dir/$container_id.gw" ] &&
        awk -v j="$jail_id" -v f="$fam" -v g="$gw" \
            '$1 == j && $2 == f && $3 == g { found=1; exit } END { exit !found }' \
            "$state_dir/$container_id.gw" 2>/dev/null
}

own_gateway_info() {
    local container_id="$1" jail_id="$2" fam="$3"
    local state_dir="${CNI_EPAIR_STATE:-/var/run/cni/freebsd-epair}"
    [ -f "$state_dir/$container_id.gw" ] &&
        awk -v j="$jail_id" -v f="$fam" '$1 == j && $2 == f { print $3, $4; exit }' \
            "$state_dir/$container_id.gw" 2>/dev/null
}

del_epair() {
    local container_id="$1"
    local state_dir="${CNI_EPAIR_STATE:-/var/run/cni/freebsd-epair}"
    rm -f "$state_dir/$container_id" "$state_dir/$container_id.gw" 2>/dev/null
}

# set_default_route <container_id> <jail_id> <inet|inet6> <gateway> <net_name>
# Replaces any default route that epair did not install itself (such as a
# private bridge network's gateway). When an earlier epair network already
# installed a default for this family:
# - netavark mode (CNI_EPAIR_NETAVARK=1): keep the first attached default
# - CNI mode: keep whichever network name sorts first alphabetically so
#   Podman's CNI Go-map iteration order cannot flip the default across starts.
set_default_route() {
    local container_id="$1" jail_id="$2" fam="$3" gw="$4" net_name="${5:-}"
    local flag="" have_own="" cur cur_info="" cur_gw="" cur_net=""
    [ "$fam" = "inet6" ] && flag="-inet6"

    for cur in $(netstat -j "$jail_id" -rn -f "$fam" 2>/dev/null | awk '$1 == "default" { print $2 }'); do
        if has_own_gateway "$container_id" "$jail_id" "$fam" "$cur"; then
            have_own=yes
        else
            route -j "$jail_id" delete $flag default "$cur" >/dev/null 2>&1 ||
                route -j "$jail_id" delete $flag default >/dev/null 2>&1 || true
        fi
    done

    if [ -z "$have_own" ]; then
        if route -j "$jail_id" add $flag default "$gw" >/dev/null 2>&1; then
            save_gateway "$container_id" "$jail_id" "$fam" "$gw" "$net_name"
        fi
    elif [ "${CNI_EPAIR_NETAVARK:-}" != "1" ] && [ -n "$net_name" ]; then
        cur_info=$(own_gateway_info "$container_id" "$jail_id" "$fam" || true)
        cur_gw=${cur_info%% *}
        cur_net=${cur_info#* }
        [ "$cur_info" = "$cur_gw" ] && cur_net=""
        if LC_ALL=C awk -v a="$net_name" -v b="$cur_net" 'BEGIN { exit !(a != "" && (b == "" || a < b)) }'; then
            if [ "$gw" != "$cur_gw" ]; then
                route -j "$jail_id" delete $flag default "$cur_gw" >/dev/null 2>&1 ||
                    route -j "$jail_id" delete $flag default >/dev/null 2>&1 || true
                if route -j "$jail_id" add $flag default "$gw" >/dev/null 2>&1; then
                    save_gateway "$container_id" "$jail_id" "$fam" "$gw" "$net_name"
                fi
            else
                save_gateway "$container_id" "$jail_id" "$fam" "$gw" "$net_name"
            fi
        fi
    fi
}

mask2prefix() {
    local m="$1" bits=0 o
    for o in $(echo "$m" | tr '.' ' '); do
        while [ "$o" -gt 0 ]; do
            bits=$((bits + (o & 1)))
            o=$((o >> 1))
        done
    done
    echo "$bits"
}

# dhcp_hostname -- the container's name (podman passes K8S_POD_NAME) as a
# valid hostname. dhclient runs on the host, so without one it sends the
# HOST's name and the router points that name at the container.
dhcp_hostname() {
    local name
    name=$(echo "$CNI_ARGS" | tr ';' '\n' | sed -n 's/^K8S_POD_NAME=//p' | head -1)
    [ -n "$name" ] || name="c-$(echo "$CNI_CONTAINERID" | cut -c1-12)"
    name=$(echo "$name" | tr 'A-Z_.' 'a-z--' | tr -cd 'a-z0-9-' | cut -c1-63 | sed 's/^-*//; s/-*$//')
    echo "${name:-container}"
}

# dhcp_lease <interface> -- ask the LAN's DHCP server for an address on an
# interface that is still on the HOST side of the epair.
#
# It has to happen here rather than inside the jail: DHCP needs BPF to
# broadcast, and a container has neither /dev/bpf nor a dhclient binary. The
# host has both, and the request carries the b-side's MAC, so a reservation
# keyed on that MAC resolves exactly as it would for a physical host.
#
# dhclient is caged with its own config and a script that records the lease and
# configures nothing: the stock /sbin/dhclient-script would rewrite the HOST's
# resolv.conf and default route.
#
# Prints "<address>/<prefix> <gateway> <dns>"; empty on failure.
dhcp_lease() {
    local iface="$1"
    local dir="${CNI_EPAIR_RUN:-/var/run}/cni-epair-dhcp.$$"
    local wait_max="${CNI_EPAIR_DHCP_TIMEOUT:-20}"
    mkdir -p "$dir" || return 1

    # The output path is baked into the script rather than passed in the
    # environment: dhclient builds the script's environment itself and does not
    # pass ours through, so an exported variable never arrives.
    printf '#!/bin/sh\nLEASE_OUT=%s\n' "$dir/result" > "$dir/script"
    cat >> "$dir/script" <<'EOS'
case "$reason" in
BOUND|RENEW|REBIND|REBOOT)
    printf '%s %s %s %s\n' "$new_ip_address" "$new_subnet_mask" \
        "$new_routers" "$new_domain_name_servers" > "$LEASE_OUT"
    ;;
esac
exit 0
EOS
    chmod 0755 "$dir/script"
    echo "interface \"$iface\" { send host-name \"$(dhcp_hostname)\"; script \"$dir/script\"; }" > "$dir/conf"

    dhclient -d -c "$dir/conf" -l "$dir/lease" -p "$dir/pid" "$iface" \
        >>"$LOG_FILE" 2>&1 &
    local dhpid=$!

    local waited=0
    while [ ! -s "$dir/result" ] && [ "$waited" -lt "$wait_max" ]; do
        kill -0 "$dhpid" 2>/dev/null || break
        sleep 1
        waited=$((waited + 1))
    done
    kill "$dhpid" 2>/dev/null || true
    wait "$dhpid" 2>/dev/null || true
    if [ -f "$dir/pid" ]; then
        kill "$(cat "$dir/pid" 2>/dev/null)" 2>/dev/null || true
    fi

    local out=""
    if [ -s "$dir/result" ]; then
        local addr mask routers dns
        read -r addr mask routers dns < "$dir/result"
        [ -n "$mask" ] || mask=255.255.255.0
        out="$addr/$(mask2prefix "$mask") ${routers%% *} ${dns%% *}"
    fi
    rm -rf "$dir"
    echo "$out"
}

cmd_add() {
    local config="$1"

    log "ADD: CNI_CONTAINERID=$CNI_CONTAINERID CNI_NETNS=$CNI_NETNS CNI_IFNAME=$CNI_IFNAME CNI_ARGS=$CNI_ARGS"
    log "ADD: config=$config"

    # Parse config - podman uses "master" for parent interface
    local net_name=$(json_get_nested "$config" "name")
    local bridge=$(json_get "$config" "master")
    [ -z "$bridge" ] && bridge=$(json_get "$config" "bridge")
    # Both spellings ("mtu": 9000 and "mtu": "9000"); unset takes the bridge's
    # once it is known to exist.
    local mtu=$(json_get_scalar "$config" "mtu")
    json_has "$config" "mtu" && [ -z "$mtu" ] &&
        die "mtu must be a number like 9000"
    if [ -n "$mtu" ]; then
        case "$mtu" in *[!0-9]*) die "mtu must be a number, got '$mtu'" ;; esac
        [ "$mtu" -ge 576 ] && [ "$mtu" -le 65535 ] || die "mtu must be 576-65535, got $mtu"
    fi

    # VLAN membership on a vlanfilter bridge. Checked here, before anything is
    # created: the values land unquoted on the addm command line.
    local vlan=$(json_get_scalar "$config" "vlan")
    local tagged=$(json_get_scalar "$config" "taggedVlans")
    # A key the parser can't read (an array, say) would otherwise drop silently
    json_has "$config" "vlan" && [ -z "$vlan" ] &&
        die "vlan must be a number like 2"
    json_has "$config" "taggedVlans" && [ -z "$tagged" ] &&
        die "taggedVlans must be a string like \"3,4\" or \"10-20\""
    local addm_opts=""
    if [ -n "$vlan" ]; then
        case "$vlan" in *[!0-9]*) die "vlan must be a number, got '$vlan'" ;; esac
        [ "$vlan" -ge 1 ] && [ "$vlan" -le 4094 ] || die "vlan must be 1-4094, got $vlan"
        addm_opts="untagged $vlan"
    fi
    if [ -n "$tagged" ]; then
        case "$tagged" in
            all|none) ;;
            *[!0-9,-]*) die "taggedVlans must be a list like 3,4 or 10-20, got '$tagged'" ;;
        esac
        addm_opts="$addm_opts tagged $tagged"
    fi
    # Without vlanfilter the bridge accepts the VLAN options and passes every VLAN
    if [ -n "$addm_opts" ] && ifconfig "$bridge" >/dev/null 2>&1 &&
        ! ifconfig "$bridge" | grep -q 'bridge flags=.*VLANFILTER'; then
        die "$bridge has no vlanfilter, so vlan/taggedVlans would not isolate anything; run: ifconfig $bridge vlanfilter"
    fi

    # Check for static IP and MAC in CNI_ARGS first (from podman --ip and --mac-address flags)
    local ip=""
    local ip6=""
    local gateway=""
    local gateway6=""
    local mac=""
    local dns=""
    local use_dhcp=""

    if [ -n "$CNI_ARGS" ]; then
        mac=$(echo "$CNI_ARGS" | tr ';' '\n' | grep '^MAC=' | cut -d= -f2)
        # One entry at a time, and both spellings. podman sends IP= for either
        # family; other runtimes use IP6= for v6. Collecting them into one
        # variable first would join two addresses with a newline, and a string
        # holding a v4 and a v6 tests as v6 -- which then reached ifconfig as a
        # single malformed argument and failed the whole add.
        local _arg
        for _arg in $(echo "$CNI_ARGS" | tr ';' '\n' | grep -E '^IP6?=' | cut -d= -f2-); do
            if is_v6 "$_arg"; then
                # No gateway is inferred: ::1 of a prefix means nothing, and
                # the router is whatever the segment says.
                case "$_arg" in */*) ip6="$_arg" ;; *) ip6="$_arg/64" ;; esac
                log "ADD: Using IPv6 from CNI_ARGS: $ip6"
            else
                case "$_arg" in */*) ip="$_arg" ;; *) ip="$_arg/24" ;; esac
                # Extract gateway from subnet (assume .1)
                gateway=$(echo "$ip" | sed 's|\.[0-9]*/.*|.1|')
                log "ADD: Using IP from CNI_ARGS: $ip gateway=$gateway"
            fi
        done
        if [ -n "$mac" ]; then
            log "ADD: Using MAC from CNI_ARGS: $mac"
        fi
        # A caller that knows the segment's routers says so, in place of the
        # .1 guess above (the netavark mode does).
        [ -n "$ip" ] && [ -n "$CNI_EPAIR_GATEWAY" ] && gateway="$CNI_EPAIR_GATEWAY"
        [ -n "$ip6" ] && [ -n "$CNI_EPAIR_GATEWAY6" ] && gateway6="$CNI_EPAIR_GATEWAY6"
    fi

    # Ask IPAM for whichever family the args did not supply. Gating this on
    # "$ip" alone meant a static IPv4 on a dual-stack network suppressed IPv6
    # entirely, while a static IPv6 still got a v4 from IPAM -- the same
    # request answered two different ways depending on which family you pinned.
    if [ -z "$ip" ] || [ -z "$ip6" ]; then
        local ipam_type=$(echo "$config" | awk -F'"ipam":' '{print $2}' | awk -F'"type":"' '{print $2}' | awk -F'"' '{print $1}')
        log "ADD: ipam_type=$ipam_type"

        if [ "$ipam_type" = "dhcp" ]; then
            # Only when no IPv4 came in: DHCP is IPv4-only here, and the
            # lease below overwrites $ip, losing a pinned address.
            #
            # Handled below, once the epair exists and carries its MAC: there
            # is no /usr/local/libexec/cni/dhcp on FreeBSD to exec.
            [ -z "$ip" ] && use_dhcp=yes
        elif [ -n "$ipam_type" ] && [ "$ipam_type" != "none" ] && [ "$ipam_type" != "static" ]; then
            local ipam_bin
            ipam_bin=$(ipam_plugin "$ipam_type") || die "IPAM plugin $ipam_type not found"
            local ipam_result=$(echo "$config" | CNI_COMMAND=ADD "$ipam_bin" 2>/dev/null)
            log "ADD: ipam_result=$ipam_result"
            # Every address, not just the first: host-local answers a
            # dual-stack conflist with one entry per family, and taking the
            # head of the list silently threw the second one away.
            local _a _g
            for _a in $(echo "$ipam_result" | grep -o '"address"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/'); do
                if is_v6 "$_a"; then
                    [ -z "$ip6" ] && ip6="$_a"
                else
                    [ -z "$ip" ] && ip="$_a"
                fi
            done
            # Gateways are matched by family rather than by position: a v4
            # gateway belongs to the v4 subnet whichever order they arrive in.
            for _g in $(echo "$ipam_result" | grep -o '"gateway"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*"\([^"]*\)"$/\1/'); do
                if is_v6 "$_g"; then
                    [ -z "$gateway6" ] && gateway6="$_g"
                else
                    [ -z "$gateway" ] && gateway="$_g"
                fi
            done
        fi
    fi

    # Fall back to MAC from config if not in CNI_ARGS
    [ -z "$mac" ] && mac=$(json_get "$config" "mac")

    # Validate
    [ -z "$bridge" ] && die "bridge not specified in config"
    [ -z "$ip" ] && [ -z "$ip6" ] && [ -z "$use_dhcp" ] && die "IP address not provided by IPAM"

    # Check bridge exists
    if ! ifconfig "$bridge" >/dev/null 2>&1; then
        die "bridge $bridge does not exist"
    fi

    # Unset: the bridge's. FreeBSD takes a 1500 member on a 9000 bridge without
    # a word, and large frames then die at the epair.
    if [ -z "$mtu" ]; then
        mtu=$(ifconfig "$bridge" 2>/dev/null | sed -n '1s/.* mtu \([0-9]*\).*/\1/p')
        [ "$mtu" = 1500 ] && mtu=""
    fi

    # Get jail ID
    local jail_id=$(get_jail_id "$CNI_CONTAINERID")
    [ -z "$jail_id" ] && die "Could not find jail for container $CNI_CONTAINERID"
    log "ADD: jail_id=$jail_id"

    # No lock: the kernel hands out the unit, so parallel creates never collide.
    local epair_a
    epair_a=$(ifconfig epair create) || die "could not create an epair"

    local epair_b=$(echo "$epair_a" | sed 's/a$/b/')
    log "ADD: created $epair_a / $epair_b"

    # Save for cleanup
    save_epair "$CNI_CONTAINERID" "$epair_a"

    # From here on a failure must not be reported as success: podman would
    # believe the container holds $ip while it has no working interface at all,
    # which looks like an application fault rather than a networking one. Each
    # step that actually builds the network is checked, and the epair we already
    # created is destroyed before bailing out so a failed ADD leaves nothing
    # behind on the bridge.
    fail_add() {
        log "ADD: FAILED: $1"
        ifconfig "$epair_a" destroy 2>/dev/null || true
        del_epair "$CNI_CONTAINERID"
        die "$1"
    }

    # Both ends, before the bridge sees the member and before the move.
    if [ -n "$mtu" ]; then
        ifconfig "$epair_a" mtu "$mtu" 2>/dev/null ||
            fail_add "could not set MTU $mtu on $epair_a"
        ifconfig "$epair_b" mtu "$mtu" 2>/dev/null ||
            fail_add "could not set MTU $mtu on $epair_b"
    fi

    # Configure host side
    # $addm_opts unquoted on purpose: it is zero or more validated words.
    ifconfig "$bridge" addm "$epair_a" $addm_opts 2>/dev/null ||
        fail_add "could not add $epair_a to bridge $bridge${addm_opts:+ with $addm_opts}"
    ifconfig "$epair_a" up 2>/dev/null ||
        fail_add "could not bring up $epair_a"

    # The MAC has to be in place BEFORE any DHCP request, so a reservation
    # keyed on it resolves; it survives the move into the jail.
    if [ -n "$mac" ]; then
        ifconfig "$epair_b" ether "$mac" 2>/dev/null ||
            fail_add "could not set MAC $mac on $epair_b"
    fi

    # DHCP runs here, on the host side: a jail has no /dev/bpf to broadcast
    # from and no dhclient to run.
    if [ -n "$use_dhcp" ]; then
        ifconfig "$epair_b" up 2>/dev/null ||
            fail_add "could not bring up $epair_b for DHCP"
        local lease=$(dhcp_lease "$epair_b")
        log "ADD: dhcp lease=$lease"
        [ -z "$lease" ] && fail_add "no DHCP response on $bridge for $epair_b"
        ip=$(echo "$lease" | awk '{print $1}')
        gateway=$(echo "$lease" | awk '{print $2}')
        dns=$(echo "$lease" | awk '{print $3}')
    fi

    # Move to jail
    ifconfig "$epair_b" vnet "$jail_id" >/dev/null 2>&1 ||
        fail_add "could not move $epair_b into jail $jail_id"

    # Configure jail side (redirect output to avoid polluting stdout)
    local ifname="${CNI_IFNAME:-eth0}"
    ifconfig -j "$jail_id" "$epair_b" name "$ifname" >/dev/null 2>&1 ||
        fail_add "could not rename $epair_b to $ifname in jail $jail_id"

    # MAC was applied host-side before the move (see above).
    local actual_mac
    if [ -n "$mac" ]; then
        actual_mac="$mac"
    else
        actual_mac=$(ifconfig -j "$jail_id" "$ifname" 2>/dev/null | grep ether | awk '{print $2}')
    fi

    # Configure IP -- the one step whose failure makes the whole result a lie.
    if [ -n "$ip" ]; then
        ifconfig -j "$jail_id" "$ifname" inet "$ip" >/dev/null 2>&1 ||
            fail_add "could not set $ip on $ifname in jail $jail_id"
    fi
    if [ -n "$ip6" ]; then
        # -ifdisabled first: FreeBSD leaves IPv6 off on an interface until
        # something asks for it, and the address is silently refused otherwise.
        ifconfig -j "$jail_id" "$ifname" inet6 -ifdisabled >/dev/null 2>&1 || true
        ifconfig -j "$jail_id" "$ifname" inet6 "$ip6" >/dev/null 2>&1 ||
            fail_add "could not set $ip6 on $ifname in jail $jail_id"
    fi

    # Replace any foreign default route (from a private bridge) while keeping
    # epair-owned defaults according to backend rules.
    if [ -n "$gateway" ]; then
        set_default_route "$CNI_CONTAINERID" "$jail_id" inet "$gateway" "$net_name"
    fi
    if [ -n "$gateway6" ]; then
        # A link-local gateway is ambiguous without the interface it is on:
        # `route add -inet6 default fe80::1` fails, fe80::1%eth0 works. Routers
        # commonly advertise exactly this.
        case "$gateway6" in
            fe80:*|FE80:*) [ "${gateway6#*%}" = "$gateway6" ] && gateway6="$gateway6%$ifname" ;;
        esac
        set_default_route "$CNI_CONTAINERID" "$jail_id" inet6 "$gateway6" "$net_name"
    fi

    # Configure loopback
    ifconfig -j "$jail_id" lo0 inet 127.0.0.1/8 >/dev/null 2>&1 || true
    ifconfig -j "$jail_id" lo0 inet6 ::1/128 >/dev/null 2>&1 || true

    # Get host-side MAC before we output results
    local host_mac=$(ifconfig "$epair_a" 2>/dev/null | grep ether | awk '{print $2}')

    log "ADD: success - $ifname=${ip:-none}/${ip6:-none} via $bridge host_mac=$host_mac actual_mac=$actual_mac"

    # Output CNI result directly to stdout
    cat <<EOF
{
  "cniVersion": "1.0.0",
  "interfaces": [
    {
      "name": "$epair_a",
      "mac": "$host_mac"
    },
    {
      "name": "$ifname",
      "mac": "$actual_mac"
    }
  ],
  "ips": [$(
    sep=""
    if [ -n "$ip" ]; then
        printf '%s\n    {"address": "%s", "gateway": "%s", "interface": 1}' "$sep" "$ip" "$gateway"
        sep=","
    fi
    if [ -n "$ip6" ]; then
        printf '%s\n    {"address": "%s", "gateway": "%s", "interface": 1}' "$sep" "$ip6" "$gateway6"
    fi
    printf '\n  '
)]$(
    # The lease's DNS server, the one thing a DHCP network knows that the
    # runtime does not.
    # Only where the network asks ("leaseDns": true): the runtime writes
    # every network's servers into resolv.conf in no fixed order, and on a
    # container that is also on a network with name resolution this one
    # can come first and answer "no such name" for the other containers.
    [ -n "$dns" ] && echo "$config" | grep -q '"leaseDns"[[:space:]]*:[[:space:]]*"\{0,1\}true' &&
        printf ',\n  "dns": {"nameservers": ["%s"]}' "$dns"
)
}
EOF
    log "ADD: completed output"
    exit 0
}

cmd_del() {
    local config="$1"

    log "DEL: CNI_CONTAINERID=$CNI_CONTAINERID"

    # Get saved epair
    local epair_a=$(get_epair "$CNI_CONTAINERID")

    if [ -n "$epair_a" ]; then
        # Destroy epair (destroys both ends)
        ifconfig "$epair_a" destroy 2>/dev/null || true
        log "DEL: destroyed $epair_a"
    fi

    del_epair "$CNI_CONTAINERID"

    # Hand the addresses back. ADD delegates allocation to the IPAM plugin, and
    # DEL never told it the container was gone -- so host-local kept every
    # reservation on disk forever and the pool drained one container at a time.
    # Both families leak together, since each is a separate reservation.
    #
    # Best effort: a failure here must not stop the runtime tearing a container
    # down, and an address that outlives its container is recoverable while a
    # container that cannot be removed is not.
    local ipam_type=$(echo "$config" | awk -F'"ipam":' '{print $2}' | awk -F'"type":"' '{print $2}' | awk -F'"' '{print $1}')
    case "$ipam_type" in
        ""|none|static|dhcp) ;; # nothing was allocated by a plugin
        *)
            local ipam_bin
            if ipam_bin=$(ipam_plugin "$ipam_type"); then
                echo "$config" | CNI_COMMAND=DEL "$ipam_bin" >/dev/null 2>&1 ||
                    log "DEL: ipam $ipam_type returned an error, addresses may stay reserved"
                log "DEL: released addresses via $ipam_type"
            fi
            ;;
    esac

    # Success (even if nothing to clean up)
    cat <<EOF
{
  "cniVersion": "1.0.0"
}
EOF
}

cmd_check() {
    local config="$1"

    local jail_id=$(get_jail_id "$CNI_CONTAINERID")
    local ifname="${CNI_IFNAME:-eth0}"

    if [ -z "$jail_id" ]; then
        die "Container not running"
    fi

    if ! ifconfig -j "$jail_id" "$ifname" >/dev/null 2>&1; then
        die "Interface $ifname not found in jail"
    fi

    cat <<EOF
{
  "cniVersion": "1.0.0"
}
EOF
}

# Extras beyond the CNI contract, one per line, for a caller that needs to know
# whether this build can do a thing before offering it. Deliberately not part of
# the VERSION reply: that schema is CNI's, not ours.
cmd_features() {
    echo "dhcp"
    echo "vlan"
}

cmd_version() {
    cat <<EOF
{
  "cniVersion": "1.0.0",
  "supportedVersions": ["0.3.0", "0.3.1", "0.4.0", "1.0.0"]
}
EOF
}

# ---------------------------------------------------------------------------
# netavark plugin mode
#
# The same file installed in a netavark plugin directory is a network driver
# for podman's netavark backend: `podman network create -d epair
# --interface-name <bridge> --ipam-driver none <name>`. netavark calls it as
# `epair info|create|setup <container>|teardown <container>` with JSON on
# stdin. setup and teardown translate to the CNI ADD and DEL above, so both
# backends get the same epair, MAC, VLAN, MTU and DHCP behaviour.
#
# Addresses: the ones podman passes (--ip, or its own pool when the network
# has a subnet) are used as given; with none, the segment's DHCP server is
# asked.
# ---------------------------------------------------------------------------

nv_die() {
    log "netavark ERROR: $1"
    printf '{"error":"%s"}\n' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    exit 1
}

# nv_str <json> <key> -- the first "key":"value"
nv_str() {
    printf '%s' "$1" | grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | head -1 | sed 's/.*"\([^"]*\)"$/\1/'
}

# nv_list <json> <key> -- every "key":"value", one per line
nv_list() {
    printf '%s' "$1" | grep -o "\"$2\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" | sed 's/.*"\([^"]*\)"$/\1/'
}

nv_bridge() {
    local b=$(nv_str "$1" network_interface)
    [ -n "$b" ] || b=$(nv_str "$1" bridge)
    [ -n "$b" ] || b=$(nv_str "$1" parent)
    echo "$b"
}

nv_create() {
    local in="$1"
    [ -n "$(nv_bridge "$in")" ] ||
        nv_die "name the bridge to join: podman network create -d epair --interface-name <bridge> ..."
    printf '%s\n' "$in"
}

nv_setup() {
    local id="$1" in="$2"
    [ -n "$id" ] || nv_die "setup needs the container id"
    local bridge=$(nv_bridge "$in")
    [ -n "$bridge" ] || nv_die "the network names no bridge"
    local ifname=$(nv_str "$in" interface_name)
    local name=$(nv_str "$in" container_name)
    local mac=$(nv_str "$in" static_mac)
    local mtu=$(nv_str "$in" mtu)
    local vlan=$(nv_str "$in" vlan)
    local tagged=$(nv_str "$in" taggedVlans)

    # The segment, per family, from the network's subnets.
    local pfx4=24 pfx6=64 gw4="" gw6="" v
    for v in $(nv_list "$in" subnet); do
        if is_v6 "$v"; then pfx6="${v##*/}"; else pfx4="${v##*/}"; fi
    done
    for v in $(nv_list "$in" gateway); do
        if is_v6 "$v"; then gw6="$v"; else gw4="$v"; fi
    done

    local args="K8S_POD_NAME=$name" ipam=dhcp
    [ -n "$mac" ] && args="$args;MAC=$mac"
    for v in $(printf '%s' "$in" | grep -o '"static_ips"[[:space:]]*:[[:space:]]*\[[^]]*\]' | grep -o '"[0-9a-fA-F:.]*"' | tr -d '"'); do
        if is_v6 "$v"; then
            args="$args;IP=$v/$pfx6"
        else
            args="$args;IP=$v/$pfx4"
            ipam=static
        fi
    done

    local conf="{\"cniVersion\":\"1.0.0\",\"name\":\"$(nv_str "$in" name)\",\"type\":\"epair\",\"master\":\"$bridge\""
    [ -n "$mtu" ] && conf="$conf,\"mtu\":\"$mtu\""
    [ -n "$vlan" ] && conf="$conf,\"vlan\":\"$vlan\""
    [ -n "$tagged" ] && conf="$conf,\"taggedVlans\":\"$tagged\""
    [ "$(nv_str "$in" lease_dns)" = true ] && conf="$conf,\"leaseDns\":true"
    conf="$conf,\"ipam\":{\"type\":\"$ipam\"}}"

    local out rc
    out=$(printf '%s' "$conf" | CNI_COMMAND=ADD CNI_CONTAINERID="$id" CNI_NETNS="$id" \
        CNI_IFNAME="${ifname:-eth0}" CNI_ARGS="$args" \
        CNI_EPAIR_NETAVARK=1 CNI_EPAIR_GATEWAY="$gw4" CNI_EPAIR_GATEWAY6="$gw6" "$0")
    rc=$?
    if [ "$rc" -ne 0 ]; then
        local msg=$(nv_str "$out" msg)
        nv_die "${msg:-the epair plugin failed}"
    fi

    # The CNI result, as netavark's status block. The container's interface is
    # the second one listed.
    local cmac=$(nv_list "$out" mac | sed -n 2p)
    # The lease's DNS server, where the network asked for it
    # (--opt lease_dns=true); see leaseDns above for why not always.
    local dns=$(printf '%s' "$out" | tr -d '\n' | grep -o '"nameservers"[[:space:]]*:[[:space:]]*\[[^]]*\]' | grep -o '"[0-9a-fA-F:.]*"' | head -1)
    local subnets="" sep="" addr gw
    for addr in $(nv_list "$out" address); do
        if is_v6 "$addr"; then gw=$(nv_list "$out" gateway | grep : | head -1); else gw=$(nv_list "$out" gateway | grep -v : | grep . | head -1); fi
        subnets="$subnets$sep{\"ipnet\":\"$addr\"${gw:+,\"gateway\":\"$gw\"}}"
        sep=","
    done
    printf '{"dns_search_domains":[],"dns_server_ips":[%s],"interfaces":{"%s":{"mac_address":"%s","subnets":[%s]}}}\n' \
        "$dns" "${ifname:-eth0}" "$cmac" "$subnets"
}

nv_teardown() {
    local id="$1"
    [ -n "$id" ] || nv_die "teardown needs the container id"
    printf '%s' '{"cniVersion":"1.0.0","type":"epair","ipam":{"type":"none"}}' |
        CNI_COMMAND=DEL CNI_CONTAINERID="$id" "$0" >/dev/null
}

case "${1:-}" in
    info)
        echo '{"version":"0.4.0","api_version":"1.0.0"}'
        exit 0
        ;;
    create)
        nv_create "$(read_config)"
        exit 0
        ;;
    setup)
        log "netavark: setup $2"
        nv_setup "$2" "$(read_config)"
        exit 0
        ;;
    teardown)
        log "netavark: teardown $2"
        cat >/dev/null
        nv_teardown "$2"
        exit 0
        ;;
esac

# Main
log "Called: CNI_COMMAND=$CNI_COMMAND"

config=$(read_config)

case "$CNI_COMMAND" in
    ADD)
        cmd_add "$config"
        ;;
    DEL)
        cmd_del "$config"
        ;;
    CHECK)
        cmd_check "$config"
        ;;
    VERSION)
        cmd_version
        ;;
    FEATURES)
        cmd_features
        ;;
    *)
        die "Unknown CNI command: $CNI_COMMAND"
        ;;
esac
